{
	"schemaVersion": 1,
	"id": "berserker_rpg",
	"version": "${version}",
	"name": "Berserker Class Mod",
	"description": "Enter a wild, relentless battle trance as a Berserker! Spell Engine Add-On",
	"authors": [
		"Fichte"
	],
	"contact": {
		"sources": "https://github.com/ProfessorFichte"
	},
	"license": "ARR",
	"icon": "assets/berserker_rpg/icon.png",
	"environment": "*",
	"entrypoints": {
		"client": [
			"com.berserker.fabric.client.FabricClient"
		],
		"main": [
			"com.berserker.fabric.FabricMod"
		],
		"modmenu": [
			"net.spell_engine.fabric.client.compat.ModMenuCompatibility"
		],
		"fabric-datagen": [
			"net.berserker_rpg.BerserkerDataGen"
		]
	},
	"mixins": [
		"berserker-class-mod.mixins.json"
	],
	"depends": {
		"fabricloader": ">=${fabric_loader_compat_version}",
		"minecraft": ">=${minecraft_compat_version}",
		"java": ">=21",
		"fabric-api": "*",
		"armor_model_api": ">=${armor_model_api_version}",
		"spell_engine": ">=${spell_engine_version}",
		"spell_power": ">=${spell_power_version}",
		"more_rpg_classes": ">=${more_rpg_library_version}"
	},
	"suggests": {
		"better_combat": "*"
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.discord": "https://discord.gg/AShKd5XrTu"
			}
		}
	}
}